# Secrets — never commit your real token
.env
.env.production

# Production bundle built by deploy.sh (holds config.js with the production token)
dist/

# Generated from .env by serve.py
web/config.js

# OS / editor noise
.DS_Store
__pycache__/
*.pyc

# Playwright MCP browser snapshots — capture tile URLs containing the Mapbox token
.playwright-mcp/

# Raw downloads and cached pipeline intermediates (re-fetch with run_pipeline.py)
data/raw/
data/cache/
data/*.json
data/*.geojson

# Photos with per-file licences (Mapillary / Wikimedia / NIAH)
web/photos/

# Big spreadsheets / local worklists
*.xlsx
*.xls
